[Unit]
Description=BMS Timeline Reminder — เตือนแผนงานที่ user จดไว้ใน job_notes เมื่อถึงวันที่ (รอบเช้า)
After=network.target

# LIVE (อนุมัติ 2026-06-20): ส่ง LINE จริง เตือนงานวันนี้ + ล่วงหน้า 1 วัน รอบ 07:30 ไทย.
# กลับเป็น shadow → ลบ " --live" ออกจาก ExecStart แล้ว daemon-reload.
[Service]
Type=oneshot
User=bms
Group=bms
WorkingDirectory=/opt/bms/app
EnvironmentFile=/opt/bms/app/.env
ExecStart=/opt/bms/venv/bin/python /opt/bms/app/scripts/timeline_reminder.py --live
Nice=10
StandardOutput=journal
StandardError=journal
